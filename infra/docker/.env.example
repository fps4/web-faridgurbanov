# Copy to .env on the ds1 host (gitignored). Compose reads it via --env-file.
IMAGE_TAG=latest
NEXT_PUBLIC_SITE_URL=https://faridgurbanov.com
# Port the host reverse proxy forwards to (matches the container's internal 3035).
# WEB_BIND=0.0.0.0 publishes on the LAN instead.
WEB_BIND=127.0.0.1
WEB_PORT=3035
