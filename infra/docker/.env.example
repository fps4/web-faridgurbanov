# Copy to .env on the ds1 host (gitignored). Compose reads it via --env-file.
IMAGE_TAG=latest
NEXT_PUBLIC_SITE_URL=https://faridgurbanov.com
# Published interface/port (matches the container's internal 3035). 0.0.0.0 = reachable on the LAN
# at ds1:WEB_PORT; set 127.0.0.1 to restrict to loopback (e.g. when a reverse proxy fronts it).
WEB_BIND=0.0.0.0
WEB_PORT=3035
